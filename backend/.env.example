# ==============================================================================
# DeepDive AI - Backend Configuration (.env.example)
# Copy this file to .env and insert your real API keys and credentials.
# NEVER commit the active .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Credentials (OpenAI or Google Gemini)
# ------------------------------------------------------------------------------
# OpenAI API key with credit balance (whisper-1, gpt-4o-mini, text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small

# Google Gemini API key (Used for resilient fallback or primary high-speed intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017 or MongoDB Atlas connection string)
# If local MongoDB is offline, the backend automatically uses an in-memory persistent fallback.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepdive_ai

# ------------------------------------------------------------------------------
# 3. Security & JWT Session Settings
# ------------------------------------------------------------------------------
# Generate a secure 256-bit hex secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long
JWT_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. Storage & Retrieval (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PATH=./chroma_data
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Media Ingestion Limits & Binary Paths
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=180

# Optional explicit paths to ffmpeg. If empty, the system checks system PATH or backend/bin/ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
